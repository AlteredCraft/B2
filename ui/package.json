{
  "name": "b2-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "B2 desktop frontend — the presentation layer over the Tauri host (crates/b2-desktop/CLAUDE.md). Vanilla TS + Vite; talks to b2-core only through the b2-desktop IPC commands, all via the one seam src/api.ts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node --experimental-strip-types scripts/gen-icons.ts",
    "test": "node --experimental-strip-types scripts/gen-icons.ts --check && node --experimental-strip-types --test --test-reporter=spec \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.9.0",
    "dompurify": "^3.4.12",
    "marked": "^15.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "bootstrap-icons": "^1.13.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
