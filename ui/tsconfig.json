{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // panes.test.ts imports "./panes.ts" by full filename — what node's type-stripping
    // needs to run the suite off the source. Safe here: noEmit, so tsc rewrites nothing.
    "allowImportingTsExtensions": true,
    // turndown (paste.ts) is CommonJS with `export =`. Vite takes its ESM `browser`
    // build and node's require-interop yields the same default, so this only tells tsc
    // to read `import TurndownService from "turndown"` the way both hosts already do.
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src"]
}
